{
  "$description": "Design tokens for the Music and Memory Task: a calm palette (warm stone neutrals, one muted teal accent) in a light and a dark version, plus type, spacing, radius and motion. W3C Design Tokens (DTCG) format, so it imports into Tokens Studio for Figma, Style Dictionary and other token tools. Sets: core (shared), light, dark. After editing, run `npm run tokens` to rebuild assets/tokens.css.",
  "core": {
    "font": {
      "$type": "fontFamily",
      "body": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"], "$description": "Body text, buttons, inputs and the task digits" },
      "heading": { "$value": ["Iowan Old Style", "Palatino Linotype", "Palatino", "URW Palladio L", "P052", "Book Antiqua", "Georgia", "serif"], "$description": "Headings: a soft serif already on every device (no download)" },
      "mono": { "$value": ["ui-monospace", "Cascadia Code", "SF Mono", "Menlo", "Consolas", "monospace"], "$description": "Code samples" }
    },
    "text": {
      "$type": "dimension",
      "xs": { "$value": "0.78rem", "$description": "Eyebrow labels, small notes" },
      "sm": { "$value": "0.9rem", "$description": "Secondary (muted) text, tables, notices" },
      "body": { "$value": "1.0625rem", "$description": "Body text (17px); inputs inherit it, so phones never zoom" },
      "h3": { "$value": "1.125rem" },
      "h2": { "$value": "1.375rem" },
      "h1": { "$value": "1.75rem", "$description": "Shrinks to 88% on phones" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "strong": { "$value": 600, "$description": "Labels, buttons, table headers" },
      "heading": { "$value": 600 }
    },
    "leading": {
      "$type": "number",
      "body": { "$value": 1.55 },
      "heading": { "$value": 1.25 }
    },
    "space": {
      "$type": "dimension",
      "1": { "$value": "4px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "5": { "$value": "20px" },
      "6": { "$value": "24px" },
      "8": { "$value": "32px" }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": "6px", "$description": "Small keys, chips" },
      "md": { "$value": "10px", "$description": "Buttons and inputs" },
      "lg": { "$value": "14px", "$description": "Cards" },
      "pill": { "$value": "999px", "$description": "Progress bars" }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms", "$description": "Button hover and press" },
      "slow": { "$value": "300ms", "$description": "Progress bar fill" }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] }
    }
  },
  "light": {
    "color": {
      "$type": "color",
      "bg": { "$value": "#f3f1ec", "$description": "Page background (warm stone)" },
      "card": { "$value": "#fcfbf8", "$description": "Cards, inputs, keypad keys" },
      "fg": { "$value": "#2a2e30", "$description": "Body text" },
      "heading": { "$value": "#23413f", "$description": "Headings (deep teal ink)" },
      "muted": { "$value": "#5f6567", "$description": "Secondary text" },
      "line": { "$value": "#e2ded6", "$description": "Card borders, table rules" },
      "line-strong": { "$value": "#868985", "$description": "Input, key and option borders (3:1 against card)" },
      "accent": { "$value": "#3f6b68", "$description": "Buttons, selection, progress, links (muted teal)" },
      "accent-hover": { "$value": "#335855", "$description": "Buttons under the mouse" },
      "accent-fg": { "$value": "#fcfbf8", "$description": "Text on accent" },
      "accent-soft": { "$value": "#e2ebe8", "$description": "Pressed keys, secondary button hover" },
      "ok": { "$value": "#3a6e4f", "$description": "Success text" },
      "bad": { "$value": "#a2463f", "$description": "Error text" },
      "warn-bg": { "$value": "#f4ecd9", "$description": "Notice background" },
      "warn-fg": { "$value": "#5c4a20", "$description": "Notice text" },
      "warn-line": { "$value": "#dccb9f", "$description": "Notice border" },
      "track": { "$value": "#e4e0d8", "$description": "Empty part of progress bars" }
    },
    "shadow": {
      "$type": "shadow",
      "card": {
        "$value": [
          { "color": "#1e2b2a0a", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
          { "color": "#1e2b2a14", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-12px" }
        ],
        "$description": "Soft lift under cards"
      }
    }
  },
  "dark": {
    "color": {
      "$type": "color",
      "bg": { "$value": "#131817", "$description": "Page background (deep slate)" },
      "card": { "$value": "#1a201f" },
      "fg": { "$value": "#dadedb" },
      "heading": { "$value": "#cfe0dc" },
      "muted": { "$value": "#99a29f" },
      "line": { "$value": "#2a3231" },
      "line-strong": { "$value": "#697372" },
      "accent": { "$value": "#93b9b3" },
      "accent-hover": { "$value": "#a8c8c3" },
      "accent-fg": { "$value": "#10201f" },
      "accent-soft": { "$value": "#213130" },
      "ok": { "$value": "#8fc4a2" },
      "bad": { "$value": "#e09a90" },
      "warn-bg": { "$value": "#2b2615" },
      "warn-fg": { "$value": "#e0cb92" },
      "warn-line": { "$value": "#4e4426" },
      "track": { "$value": "#26302f" }
    },
    "shadow": {
      "$type": "shadow",
      "card": {
        "$value": [
          { "color": "#00000040", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }
        ]
      }
    }
  }
}
